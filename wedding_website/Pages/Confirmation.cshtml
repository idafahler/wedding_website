@page "{id:int}"
@model wedding_website.Pages.ConfirmationModel
@{
    ViewData["Title"] = "Confirmation";
}

<section class="section-background text-center">
    <h1>Thank you!</h1>

    @if(Model.Guest.Attendance == true)
    {
        <h3>We can't wait to celebrate with you.</h3>
    }
    else
    {
        <h3>We're sorry you can't make it, but thank you for letting us know.</h3>
    }
    <p class="text-under-title">Your response has been sent to Alice &amp; Bob.</p>

    <article class="text-section">
        <h4>Your response</h4>

        <p>Name: @Model.Guest.FullName</p>
        <p>Email: @Model.Guest.Email</p>
        <p>Attending: @(Model.Guest.Attendance ? "Yes" : "No")</p>
        @if (!string.IsNullOrWhiteSpace(Model.Guest.Message))
        {
            <p class="optional-message-guest">Message: @Model.Guest.Message</p>
        }
    </article>

    <a asp-page="/Index" class="link-in-text">Back to home</a>
    <br />
    <a asp-page="/Rsvp" class="link-in-text">Rsvp another guest</a>
</section>