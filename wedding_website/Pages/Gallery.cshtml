    ViewData["Title"] = "Photo gallery";
}

<section class="section-background text-center">

    <h1>Photo gallery</h1>
    <p class="text-under-title">More pictures will be added after the wedding.</p>

    <div class="gallery">
        <img src="~/images/gallery1.jpg" alt="Engagement, Alice and Bob" class="gallery-image"/>
        <img src="~/images/gallery2.jpg" alt="Engagement, Alice and Bob" class="gallery-image" />
        <img src="~/images/gallery3.jpg" alt="Landscape" class="gallery-image" />
        <img src="~/images/hero.jpg" alt="Engagement, Alice and Bob" class="gallery-image" />
    </div>

</section>