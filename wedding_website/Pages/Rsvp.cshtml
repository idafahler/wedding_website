@page
@model RsvpModel
@{
    ViewData["Title"] = "Rsvp";
}
<section class="section-background container">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">

            <h1 class="text-center">RSVP</h1>
            <p class="text-under-title text-center">Please enter your information to let us know if you will be attending or not.</p>

            <form method="post">

                <!--First name-->
                <div class="mb-3">
                    <label asp-for="@Model.Guest.FirstName" class="form-label"></label>
                    <input asp-for="@Model.Guest.FirstName" class="form-control" />
                    <span asp-validation-for="@Model.Guest.FirstName" class="text-danger"></span>
                </div>
                <!--Last name-->
                <div class="mb-3">
                    <label asp-for="@Model.Guest.LastName" class="form-label"></label>
                    <input asp-for="@Model.Guest.LastName" class="form-control" />
                    <span asp-validation-for="@Model.Guest.LastName" class="text-danger"></span>
                </div>

                <!--Email-->
                <div class="mb-3">
                    <label asp-for="@Model.Guest.Email" class="form-label"></label>
                    <input asp-for="@Model.Guest.Email" class="form-control" type="email"/>
                    <span asp-validation-for="@Model.Guest.Email" class="text-danger"></span>
                </div>

                <!--Attendance-->
                <div class="mb-3">
                    <input asp-for="@Model.Guest.Attendance" class="form-check-input"/>
                    <label asp-for="@Model.Guest.Attendance" class="form-check-label"></label>
                    <span asp-validation-for="@Model.Guest.Attendance" class="text-danger"></span>
                </div>

                <!--Message-->
                <div class="mb-3">
                    <label asp-for="@Model.Guest.Message" class="form-label"></label>
                    <textarea asp-for="@Model.Guest.Message" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="@Model.Guest.Message" class="text-danger"></span>
                </div>

                <button type="submit" class="btn rsvp-button">Send</button>

            </form>
        </div>
    </div>
</section>