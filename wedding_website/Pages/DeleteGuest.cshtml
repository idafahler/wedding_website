@page "{id:int}"
@model wedding_website.Pages.DeleteGuestModel
@{
    ViewData["Title"] = "Delete guest";
}

<section class="section-background text-center">
    <h1>Delete guest</h1>
    <p class="text-under-title">Are you sure you want to delete this guest?</p>

    <p><strong>@Model.Guest.FullName</strong></p>

    <form method="post">
        <button type="submit" class="btn btn-outline-danger">Delete</button>
        <a asp-page="/Guests" class="btn btn-secondary">Cancel</a>
    </form>
</section>